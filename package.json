{
  "name": "live-game-animator",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"node server/index.mjs\"",
    "start": "concurrently -k \"vite preview --host 127.0.0.1 --port 5173 --strictPort\" \"node server/index.mjs\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "node server/index.mjs",
    "start:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-live-game-animator.ps1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:soak": "node scripts/soak-test.mjs",
    "check:release": "npm run test && npm run build"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@types/matter-js": "^0.20.2",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "matter-js": "^0.20.0",
    "obs-websocket-js": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "9.2.4",
    "jsdom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
